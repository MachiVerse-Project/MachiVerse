<div class="app-frame">
    <header class="topbar">
        <a class="brand" href="/">
            <img src="brand/icon.png" alt="MachiVerse" />
            <span class="brand-copy">MachiVerse<small>Administration · Alpha 1.0</small></span>
        </a>
        <nav class="topnav" aria-label="Administration navigation">
            <a href="/">Overview</a>
            <a href="/monitoring">Monitoring</a>
            <a href="/management">Config</a>
            <a href="/operations">Operations</a>
        </nav>
    </header>

    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <main class="shell"><h1>Page not found</h1><p><a href="/">Return to overview</a></p></main>
        </NotFound>
    </Router>
</div>
