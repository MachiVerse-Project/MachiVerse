@page "/management"
@implements IDisposable
@inject IManagementModuleBoundary ManagementStore
@inject OperationalCommandCatalog CommandCatalog
@inject MachiVerse.Administration.View.Protocol.AdminGatewaySession GatewaySession

<PageTitle>Config管理 - MachiVerse 管理ビュー</PageTitle>

<main class="shell">
    <h1>Config / 運用コマンド管理</h1>
    <p>Gateway Protocolからの投影だけを扱います。対象Configファイルやコンポーネント内部へ直接アクセスすることはありません。</p>

    <section>
        <h2>チャネル状態</h2>
        <dl>
            <dt>Config</dt>
            <dd>@FormatChannel(_snapshot.ConfigChannel)</dd>
            <dt>運用コマンド</dt>
            <dd>@FormatChannel(_snapshot.CommandChannel)</dd>
        </dl>
    </section>

    <section>
        <h2>Config投影</h2>
        @if (_snapshot.ConfigTargets.Count == 0)
        {
            <p>Config投影はまだ受信していません。</p>
        }
        else
        {
            @foreach (var config in _snapshot.ConfigTargets)
            {
                <article>
                    <h3>@config.TargetKey</h3>
                    <dl>
                        <dt>Config世代</dt><dd>@config.ConfigGeneration</dd>
                        <dt>Configダイジェスト</dt><dd><code>@(config.ConfigDigest ?? "未提供")</code></dd>
                        <dt>結果</dt><dd>@FormatState(config.Result.Status) / @config.Result.Code</dd>
                    </dl>

                    <table>
                        <thead><tr><th>キー</th><th>有効値</th><th>影響</th><th>変更可否</th></tr></thead>
                        <tbody>
                        @foreach (var entry in config.Entries)
                        {
                            <tr>
                                <td><code>@entry.Key</code></td>
                                <td><code>@(entry.Redacted ? "[非表示]" : entry.EffectiveValueJson ?? "[未提供]")</code></td>
                                <td>@FormatImpact(entry.Impact)</td>
                                <td>@FormatMutability(entry.Mutability)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button @onclick="() => BeginDraft(config)" disabled="@(!config.Entries.Any(static entry => string.Equals(entry.Mutability, "runtime-safe-alpha", StringComparison.Ordinal)))">世代 @config.ConfigGeneration からローカル下書きを開始</button>
                </article>
            }
        }
    </section>

    <section>
        <h2>ローカルConfig下書きエディター</h2>
        @if (_draftEditor.Target is null)
        {
            <p>上のConfig投影を選択するとローカル下書きを開始できます。</p>
        }
        else
        {
            <p>
                対象: <code>@_draftEditor.Target.TargetKey</code>、
                期待する基底Config世代: <strong>@_draftEditor.Target.ConfigGeneration</strong>
            </p>
            <p>ローカル検証は入力補助だけです。Gateway認可、世代確認、監査、owner validationが最終的な正本です。</p>

            <label>
                Configキー
                <select @bind="_draftKey">
                    @foreach (var entry in EditableEntries)
                    {
                        <option value="@entry.Key">@entry.Key</option>
                    }
                </select>
            </label>
            <label>
                Wire値型
                <select @bind="_draftKind">
                    @foreach (var kind in Enum.GetValues<ConfigDraftValueKind>())
                    {
                        <option value="@kind">@FormatDraftKind(kind)</option>
                    }
                </select>
            </label>
            <label>
                新しい値
                <input @bind="_draftValue" />
            </label>
            <button @onclick="AddDraftEdit" disabled="@(EditableEntries.Count == 0)">編集を追加 / 置換</button>
            <button @onclick="ValidateDraft" disabled="@(_draftEditor.Edits.Count == 0)">ローカル下書きを検証</button>
            <button @onclick="SubmitDraftAsync" disabled="@(_draftEditor.Edits.Count == 0 || !GatewaySession.Started || _submitting)">@(_submitting ? "Config変更を送信中…" : "Config変更を送信")</button>
            <button @onclick="DiscardDraft">ローカル下書きを破棄</button>

            @if (!string.IsNullOrEmpty(_draftMessage))
            {
                <p id="config-draft-message">@_draftMessage</p>
            }

            @if (_draftEditor.Edits.Count == 0)
            {
                <p>ローカル編集はありません。</p>
            }
            else
            {
                <table>
                    <thead><tr><th>キー</th><th>型付き値</th><th>操作</th></tr></thead>
                    <tbody>
                    @foreach (var edit in _draftEditor.Edits)
                    {
                        <tr>
                            <td><code>@edit.Key</code></td>
                            <td><code>@FormatConfigValue(edit.Value)</code></td>
                            <td><button @onclick="() => RemoveDraftEdit(edit.Key)">削除</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <p>
                送信成功後は確認済みConfig投影を再取得しますが、このローカル下書きが持つ元の基底世代は保持します。
                古い下書きを再送すると新しいOperationになり、期待世代が古い場合は拒否されます。
            </p>
        }
    </section>

    <section>
        <h2>追跡中の変更</h2>
        @if (_snapshot.Mutations.Count == 0)
        {
            <p>Config変更または状態変更を伴う運用コマンドはまだ準備されていません。</p>
        }
        else
        {
            <table>
                <thead><tr><th>種別</th><th>要求</th><th>OperationId</th><th>状態</th><th>結果</th><th>世代</th><th>有効Step</th></tr></thead>
                <tbody>
                @foreach (var mutation in _snapshot.Mutations)
                {
                    <tr>
                        <td>@FormatState(mutation.Kind)</td>
                        <td>@mutation.RequestKind</td>
                        <td><code>@mutation.OperationId</code></td>
                        <td>@FormatState(mutation.State)</td>
                        <td>@(mutation.ResultCode ?? "-")</td>
                        <td>@FormatGeneration(mutation)</td>
                        <td>@(mutation.EffectiveStep?.ToString() ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>運用コマンドカタログ</h2>
        @if (CommandCatalog.Descriptors.Count == 0)
        {
            <p>現在登録済みのStandard Protocol v1コマンド種別はありません。任意コマンド名、shell command、script、内部method callは無効のままです。</p>
        }
        else
        {
            <table>
                <thead><tr><th>コマンド</th><th>Payload schema</th><th>必要権限</th><th>影響</th><th>状態変更</th></tr></thead>
                <tbody>
                @foreach (var descriptor in CommandCatalog.Descriptors)
                {
                    <tr>
                        <td><code>@descriptor.CommandKind</code></td>
                        <td><code>@descriptor.PayloadSchemaId @descriptor.PayloadSchemaMajor.@descriptor.PayloadSchemaMinor</code></td>
                        <td><code>@descriptor.RequiredPermission</code></td>
                        <td>@FormatImpact(descriptor.ImpactClassification)</td>
                        <td>@(descriptor.StateChanging ? "あり" : "なし")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</main>

@code {
    private ManagementSnapshot _snapshot = default!;
    private readonly ConfigDraftEditor _draftEditor = new();
    private string _draftKey = string.Empty;
    private ConfigDraftValueKind _draftKind = ConfigDraftValueKind.Uint;
    private string _draftValue = string.Empty;
    private string? _draftMessage;
    private bool _submitting;

    private IReadOnlyList<ConfigEntryProjection> EditableEntries
        => _draftEditor.Target?.Entries
            .Where(static entry => !entry.Sensitive && string.Equals(entry.Mutability, "runtime-safe-alpha", StringComparison.Ordinal))
            .ToArray()
            ?? Array.Empty<ConfigEntryProjection>();

    protected override void OnInitialized()
    {
        _snapshot = ManagementStore.Snapshot;
        ManagementStore.Changed += OnManagementChanged;
    }

    private void OnManagementChanged()
    {
        _snapshot = ManagementStore.Snapshot;
        _ = InvokeAsync(StateHasChanged);
    }

    private void BeginDraft(ConfigTargetProjection config)
    {
        _draftEditor.Begin(config);
        _draftKey = EditableEntries.FirstOrDefault()?.Key ?? string.Empty;
        _draftKind = ConfigDraftValueKind.Uint;
        _draftValue = string.Empty;
        _draftMessage = null;
    }

    private void AddDraftEdit()
    {
        try
        {
            _draftEditor.SetEdit(_draftKey, _draftKind, _draftValue);
            _draftMessage = $"{_draftKey} のローカル編集を準備しました。";
        }
        catch (Exception ex) when (ex is FormatException or InvalidOperationException or KeyNotFoundException)
        {
            _draftMessage = ex.Message;
        }
    }

    private void RemoveDraftEdit(string key)
    {
        _draftEditor.RemoveEdit(key);
        _draftMessage = $"{key} のローカル編集を削除しました。";
    }

    private void ValidateDraft()
    {
        try
        {
            var draft = _draftEditor.BuildDraft(ManagementStore);
            _draftMessage = $"ローカル下書きは有効です: 編集 {draft.Edits.Count} 件 / 期待基底世代 {draft.BaseConfigGeneration}";
        }
        catch (Exception ex) when (ex is InvalidDataException or InvalidOperationException)
        {
            _draftMessage = ex.Message;
        }
    }

    private async Task SubmitDraftAsync()
    {
        if (_submitting) return;
        _submitting = true;
        try
        {
            var draft = _draftEditor.BuildDraft(ManagementStore);
            var result = await GatewaySession.SubmitConfigChangeAsync(draft);
            _draftMessage = $"Config変更結果: {result.Result?.Code ?? "result.missing"} / 変更後世代 {result.ResultingGeneration}";
        }
        catch (Exception ex) when (ex is InvalidDataException or InvalidOperationException or IOException)
        {
            _draftMessage = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void DiscardDraft()
    {
        _draftEditor.DiscardLocalDraft();
        _draftKey = string.Empty;
        _draftValue = string.Empty;
        _draftMessage = "ローカル下書きを破棄しました。サーバー状態と監査履歴は変更されていません。";
    }

    private static string FormatConfigValue(MachiVerse.Protocol.V1.ConfigValueWireV1 value)
        => Google.Protobuf.JsonFormatter.Default.Format(value);

    private static string FormatDraftKind(ConfigDraftValueKind kind)
        => kind.ToString() switch
        {
            "Uint" => "符号なし整数",
            "Int" => "符号付き整数",
            "Bool" => "真偽値",
            "String" => "文字列",
            var text => text,
        };

    private static string FormatChannel(ManagementChannelState channel)
    {
        var state = FormatState(channel.State);
        return channel.ReasonCode is null ? state : $"{state} ({channel.ReasonCode})";
    }

    private static string FormatState(object? value)
        => value?.ToString() switch
        {
            "Available" => "利用可能",
            "Unavailable" => "利用不可",
            "Success" => "成功",
            "Prepared" => "準備済み",
            "Submitted" => "送信済み",
            "Completed" => "完了",
            "Rejected" => "拒否",
            "Failed" => "失敗",
            null => "-",
            var text => text,
        };

    private static string FormatImpact(string? value)
        => value switch
        {
            "low" or "Low" => "低",
            "medium" or "Medium" => "中",
            "high" or "High" => "高",
            null or "" => "-",
            _ => value,
        };

    private static string FormatMutability(string? value)
        => value switch
        {
            "runtime-safe-alpha" => "Alpha実行中に変更可能",
            "operational-read-only-alpha" => "Alpha読み取り専用",
            null or "" => "-",
            _ => value,
        };

    private static string FormatGeneration(TrackedManagementMutation mutation)
    {
        var before = mutation.ExpectedBaseGeneration?.ToString() ?? "-";
        var after = mutation.ResultingGeneration?.ToString() ?? "-";
        return $"{before} → {after}";
    }

    public void Dispose() => ManagementStore.Changed -= OnManagementChanged;
}
