@page "/participation"
@implements IDisposable
@inject ViewSessionProjectionStore Session
@inject ParticipationBindingProjectionStore Binding
@inject DiverParticipationController ParticipationController
@inject ParticipationPreferenceCatalog PreferenceCatalog
@inject AbsencePolicyProfileCatalog AbsenceCatalog
@inject GeneralViewGatewaySession GatewaySession

<PageTitle>Participation</PageTitle>

<main class="shell">
    <h1>Diver Participation</h1>
    <p>
        Binding and absence-policy values below are server-confirmed projections. Local preference edits are presentation drafts only and never become binding authority by themselves.
    </p>

    <section>
        <h2>Session / local eligibility</h2>
        <dl>
            <dt>Session state</dt><dd>@Session.Snapshot.State</dd>
            <dt>Role</dt><dd>@(string.IsNullOrEmpty(Session.Snapshot.EffectiveRoleSet) ? "-" : Session.Snapshot.EffectiveRoleSet)</dd>
            <dt>Session generation</dt><dd>@Session.Snapshot.SessionGeneration</dd>
            <dt>Participation UX state</dt><dd>@ParticipationController.State</dd>
            <dt>Binding request UX</dt><dd>@(ParticipationController.CanRequestBinding ? "eligible" : "unavailable")</dd>
            <dt>Absence policy UX</dt><dd>@(ParticipationController.CanEditAbsencePolicy ? "eligible" : "unavailable")</dd>
            <dt>Diver control UX</dt><dd>@(ParticipationController.CanSubmitControl ? "eligible" : "unavailable")</dd>
        </dl>
        <p>These checks improve UX only. Gateway authorization remains mandatory for every protected request.</p>
        @if (Binding.Snapshot.State == ParticipationBindingState.None)
        {
            <button @onclick="RequestAlphaBindingAsync" disabled="@(!ParticipationController.CanRequestBinding || _submitting)">
                @(_submitting ? "Requesting Alpha binding..." : "Request Alpha binding")
            </button>
        }
        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <p>@_actionMessage</p>
        }
    </section>

    <section>
        <h2>Confirmed binding</h2>
        <dl>
            <dt>Freshness</dt><dd>@Binding.Snapshot.Freshness</dd>
            <dt>Status</dt><dd>@Binding.Snapshot.State</dd>
            <dt>Binding ID</dt><dd><code>@(Binding.Snapshot.BindingId ?? "-")</code></dd>
            <dt>Resident ID</dt><dd><code>@(Binding.Snapshot.ResidentId ?? "-")</code></dd>
            <dt>Effective from Step</dt><dd>@(Binding.Snapshot.EffectiveFromStep?.ToString() ?? "-")</dd>
            <dt>Projection basis Step</dt><dd>@(Binding.Snapshot.BasisStep?.ToString() ?? "-")</dd>
            <dt>Confirmed absence policy</dt><dd>@(Binding.Snapshot.AbsencePolicyProfile ?? "-")</dd>
            <dt>Reason</dt><dd>@(Binding.Snapshot.ReasonCode ?? "-")</dd>
        </dl>

        @if (Binding.Snapshot.State == ParticipationBindingState.ResidentDeceased)
        {
            <p>The previously bound resident is deceased. Old control is not continued; return to the normal participation flow.</p>
        }
        @if (Binding.Snapshot.Freshness == ParticipationProjectionFreshness.RefreshRequired)
        {
            <p>Reconnect refresh is required. The old projection is retained for context but is not current control authority.</p>
        }
    </section>

    <section>
        <h2>Local join preference draft</h2>
        @if (PreferenceCatalog.Profiles.Count == 0)
        {
            <p>No server/owner-installed preference profiles are registered in this build. Arbitrary resident takeover or invented preference categories are not exposed.</p>
        }
        else
        {
            <ul>
                @foreach (var profile in PreferenceCatalog.Profiles)
                {
                    <li>
                        <strong>@profile.ProfileId</strong>
                        @if (profile.AllowedPreferenceTokens.Count > 0)
                        {
                            <span> — @string.Join(", ", profile.AllowedPreferenceTokens)</span>
                        }
                    </li>
                }
            </ul>
        }
        <dl>
            <dt>Draft profile</dt><dd>@(ParticipationController.Draft.JoinPreference.ProfileId ?? "-")</dd>
            <dt>Draft preference tokens</dt><dd>@(ParticipationController.Draft.JoinPreference.PreferenceTokens.Count == 0 ? "-" : string.Join(", ", ParticipationController.Draft.JoinPreference.PreferenceTokens))</dd>
        </dl>
    </section>

    <section>
        <h2>Local absence-policy draft</h2>
        @if (AbsenceCatalog.Profiles.Count == 0)
        {
            <p>No owner-installed absence policy profiles are registered in this build. Policy categories are not invented by the browser.</p>
        }
        else
        {
            <ul>
                @foreach (var profile in AbsenceCatalog.Profiles)
                {
                    <li>@profile</li>
                }
            </ul>
        }
        <dl>
            <dt>Draft profile</dt><dd>@(ParticipationController.Draft.AbsencePolicy.ProfileId ?? "-")</dd>
            <dt>Pending OperationId</dt><dd><code>@(ParticipationController.Draft.PendingOperationId ?? "-")</code></dd>
            <dt>Local reason</dt><dd>@(ParticipationController.Draft.LastLocalReasonCode ?? "-")</dd>
        </dl>
        <p>Local edits are not shown as world-effective until authoritative Operation result and confirmed binding/policy projection arrive.</p>
    </section>

    <p><a href="/">Back to world view</a></p>
</main>

@code {
    private bool _submitting;
    private string? _actionMessage;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Binding.Changed += OnBindingChanged;
        ParticipationController.Changed += OnParticipationChanged;
        if (ParticipationController.Draft.JoinPreference.ProfileId is null &&
            PreferenceCatalog.Profiles.Any(profile => string.Equals(profile.ProfileId, "alpha.default", StringComparison.Ordinal)))
        {
            ParticipationController.SetJoinPreference("alpha.default", Array.Empty<string>());
        }
    }

    private async Task RequestAlphaBindingAsync()
    {
        _submitting = true;
        _actionMessage = null;
        try
        {
            var result = await GatewaySession.RequestAlphaBindingAsync();
            _actionMessage = $"Binding Operation {result.LastReasonCode ?? result.State.ToString()}; confirmed basis {GatewaySession.ConfirmedBasisStep?.ToString() ?? "-"}.";
        }
        catch (Exception ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void OnSessionChanged(ViewSessionProjection snapshot) => _ = InvokeAsync(StateHasChanged);
    private void OnBindingChanged(ParticipationBindingProjection snapshot) => _ = InvokeAsync(StateHasChanged);
    private void OnParticipationChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Binding.Changed -= OnBindingChanged;
        ParticipationController.Changed -= OnParticipationChanged;
    }
}
