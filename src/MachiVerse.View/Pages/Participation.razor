@page "/participation"
@implements IDisposable
@inject ViewSessionProjectionStore Session
@inject ParticipationBindingProjectionStore Binding
@inject DiverParticipationController ParticipationController
@inject ParticipationPreferenceCatalog PreferenceCatalog
@inject AbsencePolicyProfileCatalog AbsenceCatalog
@inject GeneralViewGatewaySession GatewaySession
@inject PublicationConsumer Publications
@inject PredictionStore Predictions
@inject ReconciliationCoordinator Reconciliation

<PageTitle>Diver参加</PageTitle>

<main class="shell">
    <h1>Diver参加</h1>
    <p>
        以下のバインド状態と不在ポリシーは、サーバーで確認済みの投影です。ローカルの設定変更は表示上の下書きであり、それ自体が権限や世界状態になることはありません。
    </p>

    <section>
        <h2>セッション / ローカル利用可否</h2>
        <dl>
            <dt>セッション状態</dt><dd data-e2e="session-state" data-e2e-value="@Session.Snapshot.State">@FormatState(Session.Snapshot.State)</dd>
            <dt>ロール</dt><dd data-e2e="session-role" data-e2e-value="@Session.Snapshot.EffectiveRoleSet">@(string.IsNullOrEmpty(Session.Snapshot.EffectiveRoleSet) ? "-" : Session.Snapshot.EffectiveRoleSet)</dd>
            <dt>セッション世代</dt><dd data-e2e="session-generation" data-e2e-value="@Session.Snapshot.SessionGeneration">@Session.Snapshot.SessionGeneration</dd>
            <dt>セッションDiver参照</dt><dd data-e2e="session-diver-ref" data-e2e-value="@(Session.Snapshot.DiverRef ?? "-")"><code>@(Session.Snapshot.DiverRef ?? "-")</code></dd>
            <dt>参加UI状態</dt><dd data-e2e="participation-state" data-e2e-value="@ParticipationController.State">@FormatState(ParticipationController.State)</dd>
            <dt>バインド要求</dt><dd data-e2e="binding-request-ux" data-e2e-value="@(ParticipationController.CanRequestBinding ? "eligible" : "unavailable")">@(ParticipationController.CanRequestBinding ? "利用可能" : "利用不可")</dd>
            <dt>不在ポリシー編集</dt><dd data-e2e="absence-policy-ux" data-e2e-value="@(ParticipationController.CanEditAbsencePolicy ? "eligible" : "unavailable")">@(ParticipationController.CanEditAbsencePolicy ? "利用可能" : "利用不可")</dd>
            <dt>Diver操作</dt><dd data-e2e="diver-control-ux" data-e2e-value="@(ParticipationController.CanSubmitControl ? "eligible" : "unavailable")">@(ParticipationController.CanSubmitControl ? "利用可能" : "利用不可")</dd>
        </dl>
        <p>ここでの判定はUI上の補助です。保護された要求では常にGateway側の認可が必須です。</p>
        @if (Binding.Snapshot.State == ParticipationBindingState.None)
        {
            <button data-e2e="request-alpha-binding" @onclick="RequestAlphaBindingAsync" disabled="@(!ParticipationController.CanRequestBinding || _submitting)">
                @(_submitting ? "Alphaバインドを要求中…" : "Alphaバインドを要求")
            </button>
        }
        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <p data-e2e="binding-action-message">@_actionMessage</p>
        }
    </section>

    <section>
        <h2>確認済みパブリケーション</h2>
        <dl>
            <dt>パブリケーション状態</dt><dd data-e2e="publication-lifecycle" data-e2e-value="@Publications.LifecycleState">@FormatState(Publications.LifecycleState)</dd>
            <dt>最後に受理したパブリケーション</dt><dd data-e2e="last-accepted-publication" data-e2e-value="@(Publications.LastAcceptedPublicationKind ?? "-")">@FormatPublication(Publications.LastAcceptedPublicationKind)</dd>
            <dt>基底continuity token</dt><dd data-e2e="base-continuity-token" data-e2e-value="@(Publications.LastAcceptedBaseContinuityTokenHex ?? "-")"><code>@(Publications.LastAcceptedBaseContinuityTokenHex ?? "-")</code></dd>
            <dt>continuity token</dt><dd data-e2e="continuity-token" data-e2e-value="@(Publications.LastAcceptedContinuityTokenHex ?? "-")"><code>@(Publications.LastAcceptedContinuityTokenHex ?? "-")</code></dd>
            <dt>最後に拒否したパブリケーション</dt><dd data-e2e="last-rejected-publication" data-e2e-value="@(Publications.LastRejectedPublicationKind ?? "-")">@FormatPublication(Publications.LastRejectedPublicationKind)</dd>
            <dt>continuity不一致回数</dt><dd data-e2e="continuity-mismatch-count" data-e2e-value="@Publications.ContinuityMismatchCount">@Publications.ContinuityMismatchCount</dd>
            <dt>自動再同期回数</dt><dd data-e2e="automatic-resync-count" data-e2e-value="@GatewaySession.AutomaticResyncCount">@GatewaySession.AutomaticResyncCount</dd>
            <dt>最後の自動再同期理由</dt><dd data-e2e="last-automatic-resync-reason" data-e2e-value="@(GatewaySession.LastAutomaticResyncReason ?? "-")">@(GatewaySession.LastAutomaticResyncReason ?? "-")</dd>
            <dt>再同期理由</dt><dd data-e2e="resync-reason" data-e2e-value="@(Publications.ResyncReason ?? "-")">@(Publications.ResyncReason ?? "-")</dd>
        </dl>
        <p>差分（DELTA）は、基底tokenが現在の確認済みsnapshotと完全一致する場合だけ受理されます。不一致時は表示権限を破棄し、参加状態を再取得必須にして、強制FULL受理後にだけ復旧します。</p>
    </section>

    <section>
        <h2>予測 / reconciliation</h2>
        <dl>
            <dt>有効な予測数</dt><dd data-e2e="active-prediction-count" data-e2e-value="@Predictions.Entries.Count">@Predictions.Entries.Count</dd>
            <dt>補正回数</dt><dd data-e2e="correction-count" data-e2e-value="@Reconciliation.CorrectionCount">@Reconciliation.CorrectionCount</dd>
            <dt>最後の補正Operation</dt><dd data-e2e="last-correction-operation" data-e2e-value="@(Reconciliation.LastTrace?.OperationId ?? "-")"><code>@(Reconciliation.LastTrace?.OperationId ?? "-")</code></dd>
            <dt>最後の補正理由</dt><dd data-e2e="last-correction-reason" data-e2e-value="@(Reconciliation.LastTrace?.ReasonCode ?? "-")">@(Reconciliation.LastTrace?.ReasonCode ?? "-")</dd>
            <dt>予測元の確認済み基準Step</dt><dd data-e2e="prediction-source-basis" data-e2e-value="@(Reconciliation.LastTrace?.SourceConfirmedBasisStep.ToString() ?? "-")">@(Reconciliation.LastTrace?.SourceConfirmedBasisStep.ToString() ?? "-")</dd>
            <dt>予測元continuity token</dt><dd data-e2e="prediction-source-token" data-e2e-value="@(Reconciliation.LastTrace?.SourceConfirmedTokenHex ?? "-")"><code>@(Reconciliation.LastTrace?.SourceConfirmedTokenHex ?? "-")</code></dd>
            <dt>確認済み反映待ちStep</dt><dd data-e2e="awaiting-confirmed-through-step" data-e2e-value="@(Reconciliation.LastTrace?.AwaitingConfirmedThroughStep?.ToString() ?? "-")">@(Reconciliation.LastTrace?.AwaitingConfirmedThroughStep?.ToString() ?? "-")</dd>
            <dt>reconciliation済み確認基準Step</dt><dd data-e2e="reconciled-confirmed-basis" data-e2e-value="@(Reconciliation.LastTrace?.ConfirmedBasisStep?.ToString() ?? "-")">@(Reconciliation.LastTrace?.ConfirmedBasisStep?.ToString() ?? "-")</dd>
        </dl>
        <p>予測は表示専用です。元のbasis/tokenは出所情報としてだけ保持され、新しいauthoritative world basisやcontinuity tokenにはなりません。</p>
    </section>

    <section>
        <h2>確認済みバインド</h2>
        <dl>
            <dt>鮮度</dt><dd data-e2e="binding-freshness" data-e2e-value="@Binding.Snapshot.Freshness">@FormatState(Binding.Snapshot.Freshness)</dd>
            <dt>状態</dt><dd data-e2e="binding-state" data-e2e-value="@Binding.Snapshot.State">@FormatState(Binding.Snapshot.State)</dd>
            <dt>Binding ID</dt><dd data-e2e="binding-id" data-e2e-value="@(Binding.Snapshot.BindingId ?? "-")"><code>@(Binding.Snapshot.BindingId ?? "-")</code></dd>
            <dt>Resident ID</dt><dd data-e2e="resident-id" data-e2e-value="@(Binding.Snapshot.ResidentId ?? "-")"><code>@(Binding.Snapshot.ResidentId ?? "-")</code></dd>
            <dt>確認済みDiver参照</dt><dd data-e2e="confirmed-diver-ref" data-e2e-value="@(Binding.Snapshot.DiverRef ?? "-")"><code>@(Binding.Snapshot.DiverRef ?? "-")</code></dd>
            <dt>バインド世代</dt><dd data-e2e="binding-generation" data-e2e-value="@Binding.Snapshot.BindingGeneration">@Binding.Snapshot.BindingGeneration</dd>
            <dt>有効開始Step</dt><dd data-e2e="effective-from-step" data-e2e-value="@(Binding.Snapshot.EffectiveFromStep?.ToString() ?? "-")">@(Binding.Snapshot.EffectiveFromStep?.ToString() ?? "-")</dd>
            <dt>投影基準Step</dt><dd data-e2e="projection-basis-step" data-e2e-value="@(Binding.Snapshot.BasisStep?.ToString() ?? "-")">@(Binding.Snapshot.BasisStep?.ToString() ?? "-")</dd>
            <dt>確認済み不在ポリシー</dt><dd data-e2e="confirmed-absence-policy" data-e2e-value="@(Binding.Snapshot.AbsencePolicyProfile ?? "-")">@(Binding.Snapshot.AbsencePolicyProfile ?? "-")</dd>
            <dt>理由コード</dt><dd data-e2e="binding-reason" data-e2e-value="@(Binding.Snapshot.ReasonCode ?? "-")">@(Binding.Snapshot.ReasonCode ?? "-")</dd>
        </dl>

        @if (Binding.Snapshot.State == ParticipationBindingState.ResidentDeceased)
        {
            <p>以前バインドされていたResidentは死亡しています。旧操作権限は継続せず、通常の参加フローへ戻ります。</p>
        }
        @if (Binding.Snapshot.Freshness == ParticipationProjectionFreshness.RefreshRequired)
        {
            <p>再接続後の再取得が必要です。旧投影は参照用に保持されますが、現在の操作権限としては扱いません。</p>
        }
    </section>

    <section>
        <h2>参加設定のローカル下書き</h2>
        @if (PreferenceCatalog.Profiles.Count == 0)
        {
            <p>このbuildにはサーバー/ownerが導入した参加設定profileがありません。任意のResident乗っ取りや未定義カテゴリはブラウザ側で生成しません。</p>
        }
        else
        {
            <ul>
                @foreach (var profile in PreferenceCatalog.Profiles)
                {
                    <li>
                        <strong>@profile.ProfileId</strong>
                        @if (profile.AllowedPreferenceTokens.Count > 0)
                        {
                            <span> — @string.Join(", ", profile.AllowedPreferenceTokens)</span>
                        }
                    </li>
                }
            </ul>
        }
        <dl>
            <dt>下書きprofile</dt><dd>@(ParticipationController.Draft.JoinPreference.ProfileId ?? "-")</dd>
            <dt>下書き設定token</dt><dd>@(ParticipationController.Draft.JoinPreference.PreferenceTokens.Count == 0 ? "-" : string.Join(", ", ParticipationController.Draft.JoinPreference.PreferenceTokens))</dd>
        </dl>
    </section>

    <section>
        <h2>不在ポリシーのローカル下書き</h2>
        @if (AbsenceCatalog.Profiles.Count == 0)
        {
            <p>このbuildにはownerが導入した不在ポリシーprofileがありません。ポリシーカテゴリをブラウザ側で勝手に生成しません。</p>
        }
        else
        {
            <ul>
                @foreach (var profile in AbsenceCatalog.Profiles)
                {
                    <li>@profile</li>
                }
            </ul>
        }
        <dl>
            <dt>下書きprofile</dt><dd>@(ParticipationController.Draft.AbsencePolicy.ProfileId ?? "-")</dd>
            <dt>保留中OperationId</dt><dd><code>@(ParticipationController.Draft.PendingOperationId ?? "-")</code></dd>
            <dt>ローカル理由コード</dt><dd>@(ParticipationController.Draft.LastLocalReasonCode ?? "-")</dd>
        </dl>
        <p>ローカル編集は、authoritative Operation結果と確認済みbinding/policy投影が到着するまで世界に反映済みとは表示しません。</p>
    </section>

    <p><a href="/" data-e2e="back-to-world">世界ビューへ戻る</a></p>
</main>

@code {
    private bool _submitting;
    private string? _actionMessage;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Binding.Changed += OnBindingChanged;
        ParticipationController.Changed += OnParticipationChanged;
        Predictions.Changed += OnPredictionChanged;
        Reconciliation.Corrected += OnReconciliationCorrected;
        if (ParticipationController.Draft.JoinPreference.ProfileId is null &&
            PreferenceCatalog.Profiles.Any(profile => string.Equals(profile.ProfileId, "alpha.default", StringComparison.Ordinal)))
        {
            ParticipationController.SetJoinPreference("alpha.default", Array.Empty<string>());
        }
    }

    private async Task RequestAlphaBindingAsync()
    {
        _submitting = true;
        _actionMessage = null;
        try
        {
            var result = await GatewaySession.RequestAlphaBindingAsync();
            _actionMessage = $"バインドOperation結果: {result.LastReasonCode ?? result.State.ToString()} / 確認済み基準Step: {GatewaySession.ConfirmedBasisStep?.ToString() ?? "-"}";
        }
        catch (Exception ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FormatPublication(string? value)
        => value switch
        {
            "FULL" => "全量（FULL）",
            "DELTA" => "差分（DELTA）",
            null or "" => "-",
            _ => value,
        };

    private static string FormatState(object? value)
        => value?.ToString() switch
        {
            "Ready" => "準備完了",
            "Active" => "有効",
            "None" => "未参加",
            "Confirmed" => "確認済み",
            "RefreshRequired" => "再取得が必要",
            "ResidentDeceased" => "対象Resident死亡",
            "Connecting" => "接続中",
            "Authenticating" => "認証中",
            "Syncing" => "同期中",
            "Resyncing" => "再同期中",
            "AwaitingConfirmed" => "確認済み反映待ち",
            "Unavailable" or "SessionUnavailable" => "セッション利用不可",
            "ReadOnly" => "読み取り専用",
            "EligibleUnbound" => "バインド可能",
            "Pending" => "処理中",
            "Revoked" => "失効済み",
            "Expired" => "期限切れ",
            "Faulted" or "Failed" => "失敗",
            null => "-",
            var text => text,
        };

    private void OnSessionChanged(ViewSessionProjection snapshot) => _ = InvokeAsync(StateHasChanged);
    private void OnBindingChanged(ParticipationBindingProjection snapshot) => _ = InvokeAsync(StateHasChanged);
    private void OnParticipationChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnPredictionChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnReconciliationCorrected(PredictionCorrection correction) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Binding.Changed -= OnBindingChanged;
        ParticipationController.Changed -= OnParticipationChanged;
        Predictions.Changed -= OnPredictionChanged;
        Reconciliation.Corrected -= OnReconciliationCorrected;
    }
}
