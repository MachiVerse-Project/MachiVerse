@page "/"
@implements IAsyncDisposable
@inject GeneralViewConfig Config
@inject GatewayProtocolClient Gateway
@inject GeneralViewGatewaySession GatewaySession
@inject ConfirmedWorldStore ConfirmedStore
@inject SceneProjectionAdapterRegistry SceneAdapters
@inject ThreeRendererInterop Renderer

<PageTitle>MachiVerse 一般ビュー</PageTitle>

<main class="shell">
    <h1>MachiVerse 一般ビュー</h1>
    <p>確認済み状態の表示 / Three.js レンダラー基盤。</p>
    <p><a href="/participation">Diver参加画面を開く</a></p>
    <dl>
        <dt>ライフサイクル</dt>
        <dd>@FormatState(Gateway.State)</dd>
        <dt>Gateway</dt>
        <dd>@Config.GatewayEndpoint</dd>
        @if (GatewaySession.ConfirmedBasisStep is { } confirmedBasis)
        {
            <dt>確認済み基準Step</dt>
            <dd>@confirmedBasis</dd>
        }
        <dt>目標FPS</dt>
        <dd>@Config.TargetFps</dd>
        <dt>レンダラー</dt>
        <dd>@(_rendererStatus?.Initialized == true ? $"Three.js r{_rendererStatus.ThreeRevision} / {_rendererStatus.BackendMode}" : "初期化中")</dd>
        @if (_rendererStatus is { } status)
        {
            <dt>レンダラー状態</dt>
            <dd>@FormatState(status.RendererState)</dd>
            <dt>シーンオブジェクト数</dt>
            <dd>@status.SceneObjectCount</dd>
        }
        @if (_rendererStatus?.BasisStep is { } basisStep)
        {
            <dt>描画済み確認基準Step</dt>
            <dd>@basisStep</dd>
        }
        @if (GatewaySession.LastError is { } gatewayError)
        {
            <dt>Gatewayエラー</dt>
            <dd>@gatewayError</dd>
        }
        @if (_rendererError is not null)
        {
            <dt>レンダラーエラー</dt>
            <dd>@_rendererError</dd>
        }
    </dl>
    <canvas id="machiverse-scene" aria-label="MachiVerse 世界表示領域"></canvas>
</main>

@code {
    private RendererStatus? _rendererStatus;
    private string? _rendererError;
    private bool _rendererInitialized;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        ConfirmedStore.Changed += OnConfirmedChanged;
        GatewaySession.Changed += OnGatewaySessionChanged;
        try
        {
            await GatewaySession.StartAsync();
        }
        catch
        {
            // The session exposes its bounded diagnostic and fail-closed lifecycle state.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _rendererStatus = await Renderer.InitializeHostAsync(
                "machiverse-scene",
                Config.MaxPixelRatio);
            _rendererInitialized = true;
            await RefreshProjectionAsync();
        }
        catch (Exception ex)
        {
            _rendererError = ex.Message;
        }

        StateHasChanged();
    }

    private void OnConfirmedChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(RefreshProjectionAsync);
    }

    private void OnGatewaySessionChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshProjectionAsync()
    {
        if (!_rendererInitialized || _disposed) return;

        try
        {
            if (ConfirmedStore.Current is { } confirmed)
            {
                await Renderer.ApplySceneProjectionAsync(SceneProjectionModel.FromConfirmed(confirmed, SceneAdapters));
            }
            else
            {
                await Renderer.ClearSceneProjectionAsync();
            }

            _rendererStatus = await Renderer.GetStatusAsync();
            _rendererError = null;
        }
        catch (Exception ex)
        {
            _rendererError = ex.Message;
        }

        StateHasChanged();
    }

    private static string FormatState(object? value)
        => value?.ToString() switch
        {
            "Ready" or "ready" => "準備完了",
            "Connecting" => "接続中",
            "Authenticating" => "認証中",
            "Syncing" => "同期中",
            "Resyncing" => "再同期中",
            "Degraded" => "制限状態",
            "Failed" or "failed" => "失敗",
            "Initializing" or "initializing" => "初期化中",
            null => "-",
            var text => text,
        };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ConfirmedStore.Changed -= OnConfirmedChanged;
        GatewaySession.Changed -= OnGatewaySessionChanged;
        await Renderer.DisposeAsync();
    }
}
